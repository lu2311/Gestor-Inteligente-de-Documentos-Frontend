# ==========================================
# FRONTEND (Vite)
# ==========================================
# URL absoluta del backend. Se inyecta en tiempo de BUILD, no de ejecución.
# Local (docker compose): http://localhost:3000
# Railway: https://api.tudominio.com  (o el dominio público del servicio backend-api)
VITE_API_URL=http://localhost:3000

# Tiempo máximo de espera del polling de jobs (ms). 12 min por defecto.
VITE_JOB_TIMEOUT_MS=720000
