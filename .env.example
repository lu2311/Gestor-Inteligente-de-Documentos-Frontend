# ==========================================
# FRONTEND (runtime, no build time)
# ==========================================
# URL absoluta del backend para el navegador.
# Local (docker compose standalone): http://localhost:3000
# En el compose raíz se deja vacía para usar el proxy inverso de nginx.
API_URL=http://localhost:3000

# URL interna que nginx usa como upstream. Solo aplica cuando API_URL está
# vacía (mismo origen). En Railway: http://backend-api.railway.internal:3000
API_UPSTREAM=http://backend-api:3000

# Servidor DNS para resolver API_UPSTREAM. Se autodetecta de /etc/resolv.conf.
# DNS_RESOLVER=127.0.0.11

# Tiempo máximo de espera del polling de jobs (ms). 12 min por defecto.
JOB_TIMEOUT_MS=720000
